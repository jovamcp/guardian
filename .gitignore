# Secretos y material local (regla dura 6)
compose/.env
compose/certs/*
!compose/certs/.gitkeep
vault/

# Binarios y artefactos
bin/
*.log

# binario suelto de `go build ./...` en la raíz
/guardianctl

# artefactos de release
dist/

# activación de overrides de compose (lo escribe guardianctl init)
compose/.extra-files

# override del administrador (p. ej. GPU, OPENSSL_armcap en VMs Apple Silicon); ver docs/instalacion.md
compose/local.yml

# guardianctl upgrade: versión anterior y descargas en curso
.previous/
.upgrade/
compose/.migrated
