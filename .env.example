# Copia este archivo a compose/.env (install.sh lo hace por ti) y edita los valores.
# compose/.env está ignorado por git: es el ÚNICO lugar para secretos junto a vault/.

# Dominio base. Se publican <DOMAIN>, id.<DOMAIN> y vpn.<DOMAIN>.
DOMAIN=ai.home
TZ=America/Puerto_Rico

# Open WebUI: firma de sesiones. Lo genera install.sh (openssl rand -hex 32).
WEBUI_SECRET_KEY=

# Pocket ID: clave de cifrado de la base de datos (obligatoria en Pocket ID v2).
# Lo genera install.sh (openssl rand -base64 32). Si la pierdes, pierdes el acceso a los datos.
POCKET_ID_ENCRYPTION_KEY=

# Cliente OIDC "open-webui" creado en Pocket ID (ver docs/instalacion.md).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Formulario de usuario/contraseña de Open WebUI. false = solo "Continuar con Pocket ID".
# Solo se lee en el PRIMER arranque de Open WebUI (config persistente). Para volver a
# aplicar el .env más tarde, pon ENABLE_PERSISTENT_CONFIG=false de forma temporal.
ENABLE_LOGIN_FORM=false
ENABLE_PERSISTENT_CONFIG=true

# WireGuard: nombre DNS público o IP WAN al que se conectan los clientes.
# wg-easy v15 lo pide en su asistente web (https://vpn.<DOMAIN>); aquí queda
# como referencia y guardianctl lo imprime en los siguientes pasos.
WG_HOST=
