  {
   "type": "timeseries",
   "title": "Logins y errores por hora",
   "datasource": {
    "type": "loki",
    "uid": "guardian-loki"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "guardian-loki"
     },
     "expr": "sum by (event) (count_over_time({service=\"pocket-id\", event=~\"login_token|auth_error\"}[1h]))",
     "refId": "A",
     "queryType": "range",
     "legendFormat": "{{event}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Accesos HTTP por sitio",
