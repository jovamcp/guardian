     "refId": "A",
     "queryType": "instant",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "options": {
    "showHeader": true
   }
  },
  {
   "type": "logs",
   "title": "Eventos de identidad (Pocket ID)",
   "datasource": {
    "type": "loki",
    "uid": "guardian-loki"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "guardian-loki"
     },
     "expr": "{service=\"pocket-id\", event=~\"login_authorize|login_token|auth_error\"} | json | line_format \"{{.event}} {{.status}} {{.client_ip}} {{.path}} {{.error_code}}\"",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "dedupStrategy": "none",
    "prettifyLogMessage": false
   }
