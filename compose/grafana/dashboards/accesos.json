   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "guardian-loki"
     },
     "expr": "topk(10, sum by (client_ip, dport) (count_over_time({service=\"nftables\"} | json | __error__=\"\" [24h])))",
     "refId": "A",
     "queryType": "instant",
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "labelsToFields",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ],
   "options": {
    "showHeader": true
   }
  },
  {
   "type": "table",
   "title": "IPs con más errores de autenticación (24h)",
   "datasource": {
    "type": "loki",
    "uid": "guardian-loki"
   },
