  {
   "type": "stat",
   "title": "Logins completados (24h)",
   "datasource": {
    "type": "loki",
    "uid": "guardian-loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "guardian-loki"
     },
     "expr": "sum(count_over_time({service=\"pocket-id\", event=\"login_token\"}[24h])) or vector(0)",
     "refId": "A",
     "queryType": "instant",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
