# Perfil AppArmor de Guardian para contenedores de agentes.
# Derivado del perfil docker-default (github.com/moby/profiles/apparmor, ABI 3.0) y endurecido:
# sin ptrace, sin sockets raw/packet, sin escritura en /proc y /sys, sin mount.
# Cargar:  apparmor_parser -r sandbox/apparmor/guardian-agent   (lo hace `guardianctl agent run`)
abi <abi/3.0>,

#include <tunables/global>

profile guardian-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Red: solo TCP/UDP sobre IPv4/IPv6 y sockets unix locales. Nada de raw/packet
  # (evita sniffing y falsificación) ni AF_ALG / AF_VSOCK.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix,
  deny network raw,
  deny network packet,
  deny network alg,
  deny network vsock,

  # Sin capacidades (el runner ya hace cap-drop ALL; aquí se refuerza).
  deny capability,

  file,
  umount,
  deny mount,

  # Señales: el runtime y el daemon pueden pararnos; entre procesos del propio agente sí.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=guardian-agent,

  # Sin ptrace ni siquiera dentro del contenedor.
  deny ptrace,

  # /proc: solo lectura de lo propio; nada de escrituras.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/kmem rwklx,
  deny @{PROC}/mem rwklx,

  # /sys: sin escritura ni ejecución; sin firmware ni claves de seguridad.
  deny /sys/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # El socket de Docker nunca debería estar montado; por si acaso.
  deny /var/run/docker.sock rwklx,
  deny /run/docker.sock rwklx,
}
